{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kubefin.local/contracts/events/usage-event.v1.json",
  "title": "KubeFin usage event v1",
  "description": "Proposed Gateway-to-Worker event shape for metered provider usage. Whether failed/rejected requests emit events remains for Gateway contract review. Do not emit prompts, completions, credentials, or other secrets in usage events; serialized payloads are limited to 256 KiB by the Worker.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "occurredAt", "tenantId", "provider", "model", "usage"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "eventId": { "type": "string", "format": "uuid" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "tenantId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "teamId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "workloadId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "provider": { "type": "string", "minLength": 1, "maxLength": 128 },
    "model": { "type": "string", "minLength": 1, "maxLength": 256 },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputTokens", "outputTokens"],
      "properties": {
        "inputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "examples": [
    {
      "schemaVersion": 1,
      "eventId": "d2719f32-43c1-4f42-9b4a-b14b6ad9ac2a",
      "occurredAt": "2026-10-17T05:00:00Z",
      "tenantId": "acme",
      "teamId": "ml-platform",
      "workloadId": "summarizer",
      "requestId": "req_01",
      "provider": "openai",
      "model": "example-model",
      "usage": { "inputTokens": 120, "outputTokens": 45 }
    }
  ],
  "invalidExamples": [
    {
      "schemaVersion": 1,
      "eventId": "d2719f32-43c1-4f42-9b4a-b14b6ad9ac2a",
      "occurredAt": "2026-10-17T05:00:00Z",
      "tenantId": "acme",
      "provider": "openai",
      "model": "example-model",
      "usage": { "inputTokens": -1, "outputTokens": 45 }
    },
    {
      "schemaVersion": 1,
      "eventId": "d2719f32-43c1-4f42-9b4a-b14b6ad9ac2a",
      "occurredAt": "2026-10-17T05:00:00Z",
      "tenantId": "acme",
      "provider": "openai",
      "model": "example-model",
      "usage": { "inputTokens": 120, "outputTokens": 45 },
      "prompt": "not allowed"
    }
  ]
}
