{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kubefin.local/contracts/db/usage-events.v2.json",
  "title": "usage_events v2 (MongoDB collection)",
  "description": "Usage event documents with currency-aware Stage 3 pricing. The event schemaVersion remains the Gateway event version; pricing outputs are represented by amount and ISO 4217 currency so no USD assumption is embedded in cost fields.",
  "type": "object",
  "additionalProperties": false,
  "required": ["_id", "schemaVersion", "occurredAt", "receivedAt", "tenantId", "provider", "model", "usage"],
  "properties": {
    "_id": { "type": "string", "format": "uuid" },
    "schemaVersion": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "receivedAt": { "type": "string", "format": "date-time" },
    "tenantId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "teamId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "workloadId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "provider": { "type": "string", "minLength": 1, "maxLength": 128 },
    "model": { "type": "string", "minLength": 1, "maxLength": 256 },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputTokens", "outputTokens"],
      "properties": {
        "inputTokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "outputTokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "pricingStatus": { "type": "string", "enum": ["priced", "unpriced"] },
    "costAmount": { "type": "number", "minimum": 0, "description": "Exact calculated amount in costCurrency, represented with up to 12 decimal places and stored as MongoDB Decimal128." },
    "costCurrency": { "type": "string", "pattern": "^[A-Z]{3}$", "description": "ISO 4217 currency code selected for pricing, for example INR or USD." },
    "pricingRecordId": { "type": "string", "minLength": 1, "maxLength": 128 }
  },
  "allOf": [
    {
      "if": { "properties": { "pricingStatus": { "const": "priced" } }, "required": ["pricingStatus"] },
      "then": { "required": ["costAmount", "costCurrency", "pricingRecordId"] }
    },
    {
      "if": { "properties": { "pricingStatus": { "const": "unpriced" } }, "required": ["pricingStatus"] },
      "then": { "not": { "anyOf": [{ "required": ["costAmount"] }, { "required": ["costCurrency"] }, { "required": ["pricingRecordId"] }] } }
    }
  ],
  "examples": [
    {
      "_id": "d2719f32-43c1-4f42-9b4a-b14b6ad9ac2a",
      "schemaVersion": 1,
      "occurredAt": "2026-10-17T05:00:00Z",
      "receivedAt": "2026-10-17T05:00:01Z",
      "tenantId": "acme",
      "provider": "openai",
      "model": "example-model",
      "usage": { "inputTokens": 120, "outputTokens": 45 },
      "pricingStatus": "priced",
      "costAmount": 0.00021,
      "costCurrency": "INR",
      "pricingRecordId": "example-provider-example-model-inr-2026-01"
    }
  ],
  "invalidExamples": [
    {
      "_id": "d2719f32-43c1-4f42-9b4a-b14b6ad9ac2a",
      "schemaVersion": 1,
      "occurredAt": "2026-10-17T05:00:00Z",
      "receivedAt": "2026-10-17T05:00:01Z",
      "tenantId": "acme",
      "provider": "openai",
      "model": "example-model",
      "usage": { "inputTokens": 120, "outputTokens": 45 },
      "pricingStatus": "priced",
      "costAmount": 0.00021,
      "pricingRecordId": "rate-1"
    }
  ]
}
