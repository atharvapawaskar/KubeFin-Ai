# Environment variables for Gateway service

# Server configuration
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Authentication
# Generate a secure random API key (e.g., using: openssl rand -hex 32)
API_KEY=your-secure-api-key-here
TENANT_ID=default-tenant

# Provider Routing
DEFAULT_PROVIDER=gemini

# Google Gemini Provider
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Model options: gemini-1.5-flash, gemini-1.5-pro, gemini-1.0-pro
GEMINI_MODEL=gemini-1.5-flash
# Timeout in milliseconds (default: 30000)
GEMINI_TIMEOUT_MS=30000

# OpenAI Provider (Optional)
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
# OPENAI_TIMEOUT_MS=30000

# Anthropic Provider (Optional)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_TIMEOUT_MS=30000

# Ollama Provider (Optional - Self-Hosted Open-Source Models)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3
# OLLAMA_TIMEOUT_MS=30000

# Redis Streams (Usage Events Publishing)
REDIS_URL=redis://localhost:6379
REDIS_USAGE_STREAM=usage-events
REDIS_ENABLED=true
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY_MS=100

# Rate Limiting (Per-Tenant)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_FAILURE_MODE=fail-closed
RATE_LIMIT_REDIS_KEY_PREFIX=ratelimit:tenant

# Prometheus Metrics
METRICS_ENABLED=true
# Optional token for internal scraper authorization (leave empty for unauthenticated cluster-internal scraping)
METRICS_AUTH_TOKEN=

# Policy Engine (Model Allow-List & Max Tokens Ceiling)
# Comma-separated list of permitted model identifiers (leave unset to allow all configured models)
# GATEWAY_ALLOWED_MODELS=gemini-1.5-flash,gemini-3.6-flash
# Hard upper ceiling on requested max_tokens (leave unset for no gateway ceiling)
# GATEWAY_MAX_TOKENS_LIMIT=4096

# Security & Payload Hardening
# Maximum permitted request body size in bytes (default: 1048576 = 1 MiB)
# GATEWAY_MAX_PAYLOAD_BYTES=1048576

# Reliability & Resilience (Circuit Breaker & Upstream Retry)
# Enables upstream circuit breaker protection against cascading failures (default: true)
CIRCUIT_BREAKER_ENABLED=true
# Consecutive upstream failures before tripping circuit from CLOSED to OPEN (default: 5)
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# Cooldown duration in milliseconds before allowing a probe in HALF_OPEN (default: 30000)
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000
# Maximum concurrent probe requests permitted during HALF_OPEN state (default: 1)
CIRCUIT_BREAKER_HALF_OPEN_PROBES=1

# Maximum retry attempts for transient provider failures (503, 429, 502) (default: 2)
# Note: Timeouts and aborts are NEVER retried to prevent duplicate billing
UPSTREAM_MAX_RETRIES=2
# Base exponential backoff delay in milliseconds (default: 200)
UPSTREAM_RETRY_BASE_DELAY_MS=200
# Maximum backoff delay cap in milliseconds (default: 2000)
UPSTREAM_RETRY_MAX_DELAY_MS=2000