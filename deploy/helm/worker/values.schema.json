{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1, "maximum": 100 },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      },
      "required": ["repository", "tag", "pullPolicy"]
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "appPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "metricsPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
      },
      "required": ["type", "appPort", "metricsPort"]
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string", "minLength": 1 },
        "mongoUriKey": { "type": "string", "minLength": 1 },
        "redisUrlKey": { "type": "string", "minLength": 1 }
      },
      "required": ["existingSecret", "mongoUriKey", "redisUrlKey"]
    },
    "worker": {
      "type": "object",
      "properties": {
        "pricingCurrency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "stream": { "type": "string", "minLength": 1 },
        "group": { "type": "string", "minLength": 1 },
        "batchSize": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "blockMs": { "type": "integer", "minimum": 1 },
        "claimIdleMs": { "type": "integer", "minimum": 1000 },
        "maxDeliveries": { "type": "integer", "minimum": 1, "maximum": 100 },
        "maxEventBytes": { "type": "integer", "minimum": 1024, "maximum": 262144 }
      },
      "required": ["pricingCurrency", "stream", "group", "batchSize", "blockMs", "claimIdleMs", "maxDeliveries", "maxEventBytes"]
    },
    "kubernetesDiscovery": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "clusterId": { "type": "string", "maxLength": 128 },
        "tenantLabelKey": { "type": "string", "maxLength": 253 },
        "teamLabelKey": { "type": "string", "maxLength": 253 },
        "workloadLabelKey": { "type": "string", "maxLength": 253 }
      },
      "required": ["enabled"]
    },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
    "resources": { "type": "object" }
  },
  "required": ["replicaCount", "image", "service", "secrets", "worker", "kubernetesDiscovery", "terminationGracePeriodSeconds"]
}
