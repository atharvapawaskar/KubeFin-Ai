{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1, "maximum": 100 },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      },
      "required": ["repository", "tag", "pullPolicy"]
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      },
      "required": ["type", "port"]
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string", "minLength": 1 },
        "apiKeyKey": { "type": "string", "minLength": 1 },
        "geminiApiKeyKey": { "type": "string", "minLength": 1 },
        "redisUrlKey": { "type": "string", "minLength": 1 }
      },
      "required": ["existingSecret", "apiKeyKey", "geminiApiKeyKey", "redisUrlKey"]
    },
    "gateway": {
      "type": "object",
      "properties": {
        "logLevel": { "type": "string" },
        "tenantId": { "type": "string", "minLength": 1 },
        "defaultProvider": { "type": "string" },
        "geminiModel": { "type": "string" },
        "geminiTimeoutMs": { "type": "integer", "minimum": 1 },
        "redisStream": { "type": "string", "minLength": 1 },
        "redisEnabled": { "type": "boolean" },
        "rateLimitEnabled": { "type": "boolean" },
        "rateLimitMaxRequests": { "type": "integer", "minimum": 1 },
        "rateLimitWindowMs": { "type": "integer", "minimum": 1 },
        "rateLimitFailureMode": { "type": "string", "enum": ["fail-closed", "fail-open"] },
        "metricsEnabled": { "type": "boolean" },
        "maxPayloadBytes": { "type": "integer", "minimum": 1 },
        "circuitBreakerEnabled": { "type": "boolean" },
        "circuitBreakerFailureThreshold": { "type": "integer", "minimum": 1 },
        "circuitBreakerResetTimeoutMs": { "type": "integer", "minimum": 1 },
        "circuitBreakerHalfOpenProbes": { "type": "integer", "minimum": 1 },
        "upstreamMaxRetries": { "type": "integer", "minimum": 0 },
        "upstreamRetryBaseDelayMs": { "type": "integer", "minimum": 1 },
        "upstreamRetryMaxDelayMs": { "type": "integer", "minimum": 1 }
      }
    },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
    "resources": { "type": "object" }
  },
  "required": ["replicaCount", "image", "service", "secrets", "gateway"]
}
