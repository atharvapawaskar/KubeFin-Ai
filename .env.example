# Kubefin Local Development Environment
# Copy to .env and fill in values

# MongoDB
MONGODB_URI=mongodb://localhost:27017/kubefin

# Redis (used for Redis Streams event processing)
REDIS_URL=redis://localhost:6379

# Gateway
PORT=3000
NODE_ENV=development

# Provider API Keys (optional placeholders)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Feature Flags (default OFF)
FEATURE_BUDGET_ENFORCEMENT=false
FEATURE_PII_SCANNING=false