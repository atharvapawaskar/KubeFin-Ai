# Kubefin Local Development Environment
# Copy to .env and fill in values

# MongoDB
MONGODB_URI=mongodb://localhost:27017/kubefin

# Redis (used for Redis Streams event processing)
REDIS_URL=redis://localhost:6379
REDIS_USAGE_STREAM=usage-events
REDIS_USAGE_GROUP=kubefin-worker-v1
WORKER_BATCH_SIZE=10
WORKER_BLOCK_MS=5000
WORKER_CLAIM_IDLE_MS=30000
WORKER_MAX_DELIVERIES=5
WORKER_MAX_EVENT_BYTES=262144

# Gateway
PORT=3000
NODE_ENV=development

# Provider API Keys (optional placeholders)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Feature Flags (default OFF)
FEATURE_BUDGET_ENFORCEMENT=false
FEATURE_PII_SCANNING=false
